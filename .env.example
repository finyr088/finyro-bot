# ── Обязательное ────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Telegram ID владельцев/админов через запятую (узнать: @userinfobot)
ADMIN_IDS=111111111,222222222

# ── Мини-приложение ─────────────────────────────────────────────
# Публичный HTTPS-адрес, где развёрнут этот сервис (нужен для кнопки Web App).
# Локально можно оставить пустым — кнопка приложения просто не покажется.
MINIAPP_URL=https://your-domain.example.com
# Секрет для подписи JWT (сгенерируйте случайную строку 32+ символов)
SECRET_KEY=please-change-this-to-a-long-random-string

# ── Курс и оплата ───────────────────────────────────────────────
COURSE_TITLE=Курс подготовки к отборочным этапам по финансовой грамотности
COURSE_PRICE=4 990 ₽
# Реквизиты показываются ученику при оплате (перенос строки — через \n не нужен, пишите в одну строку или задайте в коде)
PAY_REQUISITES=Перевод на карту 0000 0000 0000 0000 (Банк, Имя Ф.). После оплаты пришлите скриншот.
# Срок доступа в днях после подтверждения (0 = бессрочно)
ACCESS_DAYS=0

# ── База данных ─────────────────────────────────────────────────
# По умолчанию SQLite-файл рядом с проектом. Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/finyro
# DATABASE_URL=sqlite+aiosqlite:///./finyro.db

# ── Прочее ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
# DEV_MODE=1 позволяет открыть мини-апп в обычном браузере без Telegram (только для разработки!)
DEV_MODE=0
